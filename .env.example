# Local development defaults from Supabase's self-hosted Docker template.
# These credentials are public examples: replace every secret before deploying.
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Supabase Auth settings and SMTP relay used for verification, password-reset,
# and account-change emails. Any standard SMTP provider can be used here.
# Keep email autoconfirm disabled in production so users must verify ownership.
DISABLE_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Muse

# The API uses these aliases for the same local Supabase instance.
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Muse application services.
QDRANT_URL=http://localhost:6333
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434
# Docker Compose uses host.docker.internal by default so the server container
# can reach a local Ollama daemon. Set this only to override it (for example,
# with a remote embedding provider); keep OLLAMA_EMBEDDING_BASE_URL above for
# npm-run development on the host.
OLLAMA_EMBEDDING_BASE_URL_DOCKER=
# Linux Docker host-gateway address used by the private Compose Ollama bridge.
# Change only if `docker compose exec server getent hosts host.docker.internal`
# reports a different address.
OLLAMA_BRIDGE_HOST=172.17.0.1
OLLAMA_CHAT_MODEL=gemma4:31b-cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
# Context window in tokens passed to the chat model (also sets the char budget used to assemble RAG context).
OLLAMA_NUM_CTX=32768
# How many Qdrant matches "Ask my notes" retrieves per question.
RAG_TOP_K=10
PORT=3002
# Public address served by the Docker Nginx gateway. It is used by the Nginx
# frontend build, GoTrue email links, and Express CORS. Use your HTTPS hostname
# in production; the default is the local Compose gateway.
PUBLIC_URL=http://localhost:8080
# These three variables are for Vite's separate hot-reload development server.
# The Docker Nginx build overrides them with the same-origin gateway values.
VITE_API_URL=http://localhost:3002/api
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${ANON_KEY}

# Realtime service secrets. Replace with random values before deploying;
# REALTIME_DB_ENC_KEY must stay exactly 16 characters (AES-128 key size).
REALTIME_SECRET_KEY_BASE=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
REALTIME_DB_ENC_KEY=supabaserealtime
REALTIME_ERLANG_COOKIE=musecookie

# AES-256-GCM key for user text at rest (notes, research documents, artifacts).
# 64 hex chars = 32 random bytes. Generate with: openssl rand -hex 32
# IMPORTANT: back this up - losing it makes encrypted notes unreadable.
DATA_ENCRYPTION_KEY=

# Secure Vault / WebAuthn. PUBLIC_URL must be HTTPS in production and the RP ID
# must be the hostname only (for example notes.example.com, without https://).
# Comma-separate allowed browser origins if development uses a second origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Muse
WEBAUTHN_ORIGINS=http://localhost:8080,http://localhost:5174
STUDIO_PORT=54323
# At least 32 random characters; generate with: openssl rand -base64 48
MUSE_SESSION_SECRET=
# Turn off only after every intended account has completed and verified its
# client-side migration. Legacy rows are never purged automatically.
VAULT_LEGACY_MIGRATION=enabled

# Address phones use to reach Muse when the server runs in Docker (pairing QR code).
# Docker hides the host LAN IP, so set it here. Leave blank to auto-detect.
MUSE_LAN_IP=
MUSE_TAILSCALE_IP=
MUSIC_DOWNLOADER_URL=http://localhost:8001
